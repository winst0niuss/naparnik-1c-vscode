{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    // TypeScript 6 (встроен в VS Code) больше не подключает @types автоматически — указываем явно
    "types": ["node"]
  },
  "include": ["src"]
}
